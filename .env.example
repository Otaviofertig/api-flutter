# Libria — configuração de ambiente
#
# Copie este arquivo para `.env` (que NÃO é versionado) e ajuste os valores:
#     cp .env.example .env
#
# ATENÇÃO: em Flutter o `.env` é embarcado como asset dentro do APK/IPA.
# Ele serve para tirar credenciais do Git e trocar de ambiente sem recompilar,
# mas não protege segredos de quem tem o binário. Chaves realmente sensíveis
# devem ficar em um backend intermediário.

# --- Open Library (endpoints públicos) ---------------------------------------
OPENLIBRARY_BASE_URL=https://openlibrary.org
OPENLIBRARY_COVERS_URL=https://covers.openlibrary.org

# E-mail de contato enviado no User-Agent, conforme as boas práticas de uso
# da API. Use um endereço real do time.
OPENLIBRARY_CONTACT_EMAIL=contato@libria.app

# --- Rede ---------------------------------------------------------------------
REQUEST_TIMEOUT_SECONDS=20
SEARCH_PAGE_SIZE=20

# --- Credenciais (opcionais) --------------------------------------------------
# Chaves S3-like da Open Library, necessárias apenas nos endpoints de escrita/
# importação. O Libria é somente leitura: deixe em branco.
OPENLIBRARY_ACCESS_KEY=
OPENLIBRARY_SECRET_KEY=

# --- Firebase (autenticação) --------------------------------------------------
# Substituem o firebase_options.dart do `flutterfire configure`, que traria as
# chaves para dentro do repositório. Pegue os valores em:
#   Console do Firebase > Configurações do projeto > Seus aplicativos
#
# Sem os quatro primeiros preenchidos o app sobe SEM login, usando apenas o
# acervo público da Open Library.
#
# Habilite no console os provedores "E-mail/senha" e "Google" em
# Authentication > Sign-in method.
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=

# Opcionais (a web usa o authDomain; o storageBucket só é necessário com Storage)
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=

# --- Firebase por plataforma (opcional) ---------------------------------------
# O console emite um `appId` diferente para CADA plataforma registrada, e em
# geral uma `apiKey` diferente também. Preencher acima com as chaves da web e
# rodar no Android entrega ao initializeApp um appId que não é o do Android.
#
# Para servir mais de uma plataforma com o mesmo arquivo, prefixe a chave com a
# plataforma. A variante com prefixo VENCE a genérica; sem ela, a genérica vale.
# Assim o que é do projeto (PROJECT_ID, MESSAGING_SENDER_ID) fica declarado uma
# vez só, acima, e só o que muda por plataforma se repete aqui.
#
# Prefixos aceitos: WEB, ANDROID, IOS, MACOS, WINDOWS.
# Todas as seis chaves aceitam prefixo — inclusive AUTH_DOMAIN e STORAGE_BUCKET.
#
# Exemplo de web + Android convivendo:
#     FIREBASE_WEB_API_KEY=AIza...web
#     FIREBASE_WEB_APP_ID=1:1234567890:web:abc123
#     FIREBASE_WEB_AUTH_DOMAIN=seu-projeto.firebaseapp.com
#     FIREBASE_ANDROID_API_KEY=AIza...android
#     FIREBASE_ANDROID_APP_ID=1:1234567890:android:def456
#
# No Linux o Firebase não tem suporte: lá só as genéricas são lidas, e o app
# sobe sem login.
