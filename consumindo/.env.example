# Libria — configuração de ambiente
#
# Copie este arquivo para `.env` (que NÃO é versionado) e ajuste os valores:
#     cp .env.example .env
#
# ATENÇÃO: em Flutter o `.env` é embarcado como asset dentro do APK/IPA.
# Ele serve para tirar credenciais do Git e trocar de ambiente sem recompilar,
# mas não protege segredos de quem tem o binário. Chaves realmente sensíveis
# devem ficar em um backend intermediário.

# --- Open Library (endpoints públicos) ---------------------------------------
OPENLIBRARY_BASE_URL=https://openlibrary.org
OPENLIBRARY_COVERS_URL=https://covers.openlibrary.org

# E-mail de contato enviado no User-Agent, conforme as boas práticas de uso
# da API. Use um endereço real do time.
OPENLIBRARY_CONTACT_EMAIL=contato@libria.app

# --- Rede ---------------------------------------------------------------------
REQUEST_TIMEOUT_SECONDS=20
SEARCH_PAGE_SIZE=20

# --- Credenciais (opcionais) --------------------------------------------------
# Chaves S3-like da Open Library, necessárias apenas nos endpoints de escrita/
# importação. O Libria é somente leitura: deixe em branco.
OPENLIBRARY_ACCESS_KEY=
OPENLIBRARY_SECRET_KEY=
